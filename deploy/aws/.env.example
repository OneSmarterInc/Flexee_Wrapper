# Copy to deploy/aws/.env and fill in. Never commit the real .env.
SITE_DOMAIN=learn.flexee.org
# RDS endpoint from the AWS console; the database name "flexee" is set when the instance is created.
DATABASE_URL=postgres://flexee:REPLACE_WITH_DB_PASSWORD@REPLACE_WITH_RDS_ENDPOINT:5432/flexee?sslmode=require
