# Copy to deploy/aws/.env and fill in. Never commit the real .env.
SITE_DOMAIN=learn.flexee.org
# RDS endpoint from the AWS console; the database name "flexee" is set when the instance is created.
DATABASE_URL=postgres://flexee:REPLACE_WITH_DB_PASSWORD@REPLACE_WITH_RDS_ENDPOINT:5432/flexee?sslmode=require

# --- Spec 28: the box, not Vercel ------------------------------------------------------------
# Postgres is local to the box (Addendum F: no RDS yet). The database name has one x, not two:
# flexxe_wrapper was renamed to flexee_wrapper on 9 October 2026, database only — the role kept
# the name it had, which is why the two do not match.
DATABASE_URL=postgres://REPLACE_WITH_THE_EXISTING_ROLE:REPLACE_WITH_DB_PASSWORD@127.0.0.1:5432/flexee_wrapper

# The three directories, all outside the git checkout. deploy.sh refuses to run if any of them
# resolves inside it: content/ is tracked, so a publish would modify tracked files and the next
# `git pull --ff-only` would refuse. They are plain directories on the root disk today.
CONTENT_DIR=/var/lib/flexee/content
FILES_DIR=/var/lib/flexee/files
INTAKE_WORK_DIR=/var/lib/flexee/work

# fs, so the books are read from CONTENT_DIR. The intake publishes to the same place, with no
# prefix — live/ was a Vercel Blob prefix and the app's FsStore does not use it.
CONTENT_STORE=fs

# worker: the app does not dispatch a GitHub workflow for an intake; flexee-intake.service polls
# library_uploads instead. Set this and GITHUB_DISPATCH_TOKEN is not needed for the book flow.
# Leaving it unset (or "github") keeps the old workflow path, which is the written-down fallback.
INTAKE_MODE=worker

# The worker refuses to start a book when free disk would fall below this, so that adding a book
# cannot fill a disk five services share. Default 1024.
INTAKE_MIN_FREE_MB=1024
