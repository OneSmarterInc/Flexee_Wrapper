# Postgres connection for the reader's accounts, enrolment, and bookmarks
DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/flexee

# Where the content trees live (sad/, mis3000/, …). Defaults to ./content
# CONTENT_DIR=./content

# --- Book content: where the app reads books from ---------------------------------------
# fs (default): the content/ folder shipped with the app.  blob: Vercel Blob (private).  s3: an S3 bucket.
CONTENT_STORE=fs
# CONTENT_BLOB_ACCESS=private           # blob only; keep books private
# BLOB_READ_WRITE_TOKEN=                  # blob only; Vercel sets it when the Blob store is connected
# CONTENT_BUCKET=flexee-books-test        # s3 only
# CONTENT_PREFIX=live/                    # blob and s3; path prefix for published books
# AWS_REGION=us-east-2                    # s3 only
# AWS_ACCESS_KEY_ID= / AWS_SECRET_ACCESS_KEY=   # s3 on Vercel only; on AWS use the instance's IAM role
# CONTENT_CACHE_SECONDS=300               # how long each instance keeps a read in memory
# DB_POOL_MAX=3                           # serverless hosts: keep database connections per instance low
