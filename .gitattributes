# Normalize text files to LF in the repository, whatever the developer's platform.
* text=auto eol=lf
# Spec 17: the D2L fixtures are byte-exact. CRLF line endings and a byte-order mark are what
# they exist to test, so git must not normalize them.
scripts/fixtures/*.csv -text
# Binary files: never touch.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.zip binary
*.pdf binary
*.docx binary
*.pptx binary
*.xlsx binary
*.woff binary
*.woff2 binary
